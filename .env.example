# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Keep the model selectable per environment. Choose it when AI implementation begins.
OPENAI_MODEL=

# Optional future location provider. Demo mode does not require map credentials.
MAPS_PROVIDER=demo
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
