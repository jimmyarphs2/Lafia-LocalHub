# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
# Preferred modern client credential.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# HMAC key for privacy-preserving auth/guest-intent limits (32+ random bytes).
AUTH_RATE_LIMIT_HMAC_KEY=
# Declare only the edge that overwrites forwarded client IPs: cloudflare or vercel.
AUTH_TRUSTED_INGRESS=
# Dedicated bearer credential for /api/internal/media/cleanup (32+ characters).
MEDIA_CLEANUP_SECRET=
OPENAI_API_KEY=

# Keep the model selectable per environment. Choose it when AI implementation begins.
OPENAI_MODEL=

# Optional future location provider. Demo mode does not require map credentials.
MAPS_PROVIDER=demo
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
